# Copy to `.env` in the repo root. Every app loads this one file in development.
# In production, set these as real environment variables on the host instead.

# ── Database ────────────────────────────────────────────────────────────────
# Neon, branch "dev": the *pooled* connection string (host contains `-pooler`) for the app…
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# …and the *direct* connection string for migrations.
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Neon, branch "test": used only by `pnpm test`, which DELETES ALL ROWS. Never point at real data.
TEST_DATABASE_URL=postgres://USER:PASSWORD@ep-yyy.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Optional offline alternative (`pnpm db:up` starts Postgres in Docker):
# DATABASE_URL=postgres://bc:bc@localhost:5432/bookmark_captain
# TEST_DATABASE_URL=postgres://bc:bc@localhost:5432/bookmark_captain_test

# ── API (apps/api) ──────────────────────────────────────────────────────────
PORT=4000
LOG_LEVEL=info
# Public URL of the API (used to build the OAuth redirect URI).
API_URL=http://localhost:4000
# Public URL of the web app (the only CORS origin allowed; where users land after login).
WEB_URL=http://localhost:3000
# In production with app.example.com + api.example.com, set to `example.com`
# so the web server can read the session cookie too.
# COOKIE_DOMAIN=example.com
# Number of reverse proxies in front of the API (1 on Railway/Fly/Render). Needed for correct client IPs.
TRUST_PROXY=0
SESSION_TTL_DAYS=30

# Google OAuth (https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application).
# Authorized redirect URI: {API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Passwordless email-only login for local development. Refused when NODE_ENV=production
# or when API_URL is not a localhost address. Never set this on a deployed server.
AUTH_DEV_LOGIN=true

# ── Web (apps/web) ──────────────────────────────────────────────────────────
# API URL as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
# API URL as seen by the Next.js server (optional; e.g. a private network address).
# API_INTERNAL_URL=http://api.internal:4000
