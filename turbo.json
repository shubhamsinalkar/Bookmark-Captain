{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalPassThroughEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!.env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "WEB_URL", "EXTENSION_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
